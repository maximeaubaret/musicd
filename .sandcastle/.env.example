# Codex authentication comes from the host's ~/.codex directory.
# Run `codex login` on the host before starting Sandcastle.

SANDCASTLE_MAX_ISSUES=1
SANDCASTLE_PARALLEL_ISSUES=1
SANDCASTLE_IDLE_TIMEOUT_SECONDS=1800
SANDCASTLE_CODEX_MODEL=gpt-5.6-sol
SANDCASTLE_CODEX_EFFORT=high
SANDCASTLE_DOCKER_IMAGE=musicd-sandcastle:latest
