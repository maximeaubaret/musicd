# Server overrides (applied after ~/.config/musicd/server.json is present)
JELLYFIN_SERVER_URL=http://localhost:8096
DAEMON_BIND_HOST=127.0.0.1
DAEMON_BIND_PORT=8765
# DAEMON_PASSWORD=your-secure-password-here
AUDIO_DEVICE=default

# CLI connection overrides
DAEMON_HOST=127.0.0.1
DAEMON_PORT=8765
DAEMON_PROTOCOL=http
# DAEMON_PASSWORD=your-secure-password-here
# DAEMON_ALLOW_INSECURE_HTTP=false

# Run `musicd-server`, then `musicd setup`, on a clean install. Setup stores
# server config in ${XDG_CONFIG_HOME:-~/.config}/musicd/server.json and validated
# Jellyfin authentication in ${XDG_DATA_HOME:-~/.local/share}/musicd/auth.json.
